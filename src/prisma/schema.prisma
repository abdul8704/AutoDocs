// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String   @id @default(uuid())
  name          String
  githubId      String?  @unique
  email         String   @unique
  profileUrl    String?
  password_hash String?
  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt

  // Set once the user installs our GitHub App (via the setup callback). Lets us
  // know whether to show "Connect GitHub" vs. the accessible-repos list, and which
  // installation to use when talking to the GitHub API on this user's behalf.
  githubInstallationId Int?

  refresh_sessions RefreshSession[]
  repos            Repo[]

  planType      String   @default("FREE")
  usedDocsQuota Int      @default(0)
  llmCache       LLMCache[]
}

model RefreshSession {
  id                 String    @id @default(uuid())
  userId             String
  hashedRefreshToken String
  expiresAt          DateTime
  revokedAt          DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Repo {
  id                    String   @id @default(uuid())
  user_id               String
  github_repo_id        String   @unique
  full_name             String?
  
  installation_id       Int
  clone_url             String
  last_processed_commit String?

  jobs                  DocsUpdateJob[]

  created_at            DateTime @default(now())
  updated_at            DateTime @updatedAt

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  llmCache       LLMCache[]

}

model LLMTaskConfig {
  id                String   @id @default(uuid())
  taskKey           String   @unique // e.g., 'tinyRepo', 'judge'
  modelRosterId     String 
  model             ModelRoster   @relation(fields: [modelRosterId], references: [id], onDelete: Restrict)

  promptId          String
  prompt            Prompt   @relation(fields: [promptId], references: [id], onDelete: Restrict)
  temperature       Float    @default(0.2)
  maxOutputTokens   Int?
  updatedAt         DateTime @updatedAt
}

model Prompt {
  id            String   @id @default(uuid())
  prompt_key    String  
  version       String
  content       String
  
  taskConfigs  LLMTaskConfig[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ModelRoster{
  id String   @id @default(uuid())
  modelName String
  provider String 
  contextWindow Int? @default(1048576)
  taskConfigs  LLMTaskConfig[]
  
  @@unique([ modelName, provider ])
}

model DocsUpdateJob{
  id String @id @default(uuid())

  repoId String
  repository    Repo  @relation(fields: [repoId], references: [id], onDelete: Cascade)

  triggerCommit String? @default("") // the SHA of commit which we are working on  
  status JobStatus      @default(PENDING)

  pullRequestId      Int?
  branchName         String?

  prLink   String?

  errorLog           String?
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt
}

enum JobStatus {
  PENDING       // Webhook received, sitting in queue
  CLONING       // Cloning the repo
  SCANING       // preprocessing before sending to LLM
  GENERATING    // LLM is currently processing the diff
  PR_OPEN       // Generation successful, PR is waiting for user review
  COMPLETED     // User merged the PR
  FAILED        // Something crashed

  WAITING_LLM_JUDGE // for webhook requests
  LLM_JUDGE_REJECTED // LLM rejected the diff
  DROPPED // Diff not relevant for docs update
}

model LLMLog {
  id            String   @id @default(uuid())
  jobId         String?  
  taskKey       String   
  provider      String   
  modelName     String   
  status        String   
  durationMs    Int      
  inputTokens   Int?     @default(0)
  outputTokens  Int?     @default(0)
  error         String?  
  resultSummary String?  
  createdAt     DateTime @default(now())

  @@index([taskKey])
  @@index([createdAt])
}

model LLMCache {
  id String @id @default(uuid())

  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  repoId String
  repo Repo @relation(fields: [repoId], references:[github_repo_id], onDelete: Cascade)

  taskKey String 
  commitSha String

  cacheName String
  model     String
  
  expiresAt DateTime

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, repoId, taskKey])
}