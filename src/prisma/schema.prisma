// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String   @id @default(uuid())
  name          String
  githubId      String?  @unique
  email         String   @unique
  profileUrl    String?
  password_hash String?
  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt

  // Set once the user installs our GitHub App (via the setup callback). Lets us
  // know whether to show "Connect GitHub" vs. the accessible-repos list, and which
  // installation to use when talking to the GitHub API on this user's behalf.
  githubInstallationId Int?

  refresh_sessions RefreshSession[]
  repos            Repo[]

  planType      String   @default("FREE")
  usedDocsQuota Int      @default(0)
}

model RefreshSession {
  id                 String    @id @default(uuid())
  userId             String
  hashedRefreshToken String
  expiresAt          DateTime
  revokedAt          DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Repo {
  id                    String   @id @default(uuid())
  user_id               String
  github_repo_id        String   @unique
  full_name             String
  
  installation_id       Int
  clone_url             String
  last_processed_commit String?
  created_at            DateTime @default(now())
  updated_at            DateTime @updatedAt

  // Free-text instructions the repo owner adds on top of our prompts. Stored
  // already sanitized — every write goes through the prompt-injection guard.
  arch_prompt        String?
  module_prompt      String?
  prompts_updated_at DateTime?

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  module_docs   ModuleDoc[]
  doc_state     RepoDocState?
  notifications Notification[]
}

// ============================================================================
// Documentation pipeline
// ============================================================================

// One row per generated module doc. (repo_id, module_id) is the identity;
// input_hash is the cache key: if a freshly computed Module.inputHash matches,
// the stored markdown is current and no LLM call is needed.
model ModuleDoc {
  id           String   @id @default(uuid())
  repo_id      String
  module_id    String // full dir path, e.g. "src/orders" or "(root)" / "(repo)"
  display_name String
  input_hash   String
  markdown     String
  incomplete   Json     @default("[]") // IncompleteFeature[] excluded from the markdown
  created_at   DateTime @default(now())
  updated_at   DateTime @updatedAt

  // repo_id here is the github_repo_id — the identifier queue payloads and the
  // pipeline carry everywhere (same convention as Notification).
  repo Repo @relation(fields: [repo_id], references: [github_repo_id], onDelete: Cascade)

  @@unique([repo_id, module_id])
  @@index([repo_id])
}

// One row per repo: the architecture doc + run-level state the webhook
// pipeline diffs against (intent hash, prompt version).
// One row per doc-generation run outcome — written ALWAYS, whether the run
// succeeded, raised the PR with warnings, or failed partway. repo_id is the
// github_repo_id, which is what the queue payload and pipeline actually carry.
model Notification {
  id         String   @id @default(uuid())
  repo_id    String
  kind       String   @default("DOC_RUN")
  status     String // "SUCCESS" | "PARTIAL" | "FAILED"
  message    String
  pr_url     String?
  logs       Json     @default("{}")
  created_at DateTime @default(now())

  repo Repo @relation(fields: [repo_id], references: [github_repo_id], onDelete: Cascade)

  @@index([repo_id, created_at])
}

model RepoDocState {
  repo_id         String   @id
  arch_doc        String?
  owner_report    String?
  intent_hash     String?
  prompt_version  String?
  resolution_rate Float?
  route_kind      String? // "TINY" | "NORMAL" — hysteresis for threshold flapping later

  // Consecutive "no update needed" verdicts from the push judge. Reset to 0 on
  // every regeneration; at MAX_JUDGE_SKIPS the next push regenerates unjudged.
  judge_skip_count Int @default(0)

  updated_at      DateTime @updatedAt

  // repo_id here is the github_repo_id (same convention as ModuleDoc/Notification).
  repo Repo @relation(fields: [repo_id], references: [github_repo_id], onDelete: Cascade)
}
