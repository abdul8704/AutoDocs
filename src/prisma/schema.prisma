// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String   @id @default(uuid())
  name          String
  githubId      String?  @unique
  email         String   @unique
  profileUrl    String?
  password_hash String?
  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt

  // Set once the user installs our GitHub App (via the setup callback). Lets us
  // know whether to show "Connect GitHub" vs. the accessible-repos list, and which
  // installation to use when talking to the GitHub API on this user's behalf.
  githubInstallationId Int?

  refresh_sessions RefreshSession[]
  repos            Repo[]

  planType      String   @default("FREE")
  usedDocsQuota Int      @default(0)
}

model RefreshSession {
  id                 String    @id @default(uuid())
  userId             String
  hashedRefreshToken String
  expiresAt          DateTime
  revokedAt          DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Repo {
  id                    String   @id @default(uuid())
  user_id               String
  github_repo_id        String   @unique
  full_name             String?
  
  installation_id       Int
  clone_url             String
  last_processed_commit String?
  created_at            DateTime @default(now())
  updated_at            DateTime @updatedAt

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)
}

model LLMTaskConfig {
  id                String   @id @default(uuid())
  taskKey           String   @unique // e.g., 'tinyRepo', 'judge'
  provider          String   // e.g., 'gemini', 'anthropic'
  model             String   // e.g., 'gemini-2.5-pro', 'claude-3-5-sonnet'
  temperature       Float    @default(0.2)
  systemInstruction String?
  updatedAt         DateTime @updatedAt
}

model Prompt {
  id            String   @id @default(uuid())
  prompt_key    String   @unique // e.g., 'tinyRepo', 'judge'
  version       String
  content       String
  is_current     Boolean   @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}